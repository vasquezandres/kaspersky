---
import ProductLayout from '../../layouts/ProductLayout.astro';
import Icon from '../../components/Icon.astro';
const lang = 'en' as const;
const faqs = [
  { q: 'What makes Premium different?', a: 'It is the most complete plan for home: it includes Standard and Plus, with the highest tier of features and priority support. We explain the scope when quoting.' },
  { q: 'How many devices does it cover?', a: 'Options for 1, 3, 5, 10 and up to 20 devices for 1 or 2 years.' },
  { q: 'Is it a good option for a large family?', a: 'Yes, especially the 10 or 20 device options.' },
  { q: 'Does it include support?', a: 'Premium includes priority support from the vendor; plus you get local support from Solutech Panamá.' },
  { q: 'How many devices can I protect with Premium?', a: 'Options range from 1 to 20 devices, perfect for families or people with several computers and phones.' },
  { q: 'Does Premium include parental control?', a: 'Family-protection features depend on the edition; in many cases it is complemented with Kaspersky Safe Kids. We advise based on your needs.' }
];
---
<ProductLayout
  lang={lang}
  esPath="/kaspersky-premium-panama/"
  title="Kaspersky Premium Panama | Quotes and installation — Solutech"
  description="Buy Kaspersky Premium in Panama: the most complete plan for home, multi-device, with priority support. Quotes and installation with local support from Solutech."
  h1="Kaspersky Premium in Panama"
  intro="The maximum level of home protection: everything in Standard and Plus, with advanced features and priority support. Available for up to 20 devices."
  eyebrow="Home"
  breadcrumbName="Kaspersky Premium"
  segment="home"
  match="Kaspersky Premium (LA)"
  configHeading="Configure your Kaspersky Premium"
  faqs={faqs}
  waText="Hi, I'd like a quote for Kaspersky Premium. I have ___ devices for ___ year(s)."
  ctaHeading="The most complete plan for your home"
  ctaText="Get a quote for Kaspersky Premium with local support in Panama."
  ctaLabel="Quote on WhatsApp"
>
  <section class="section"><div class="container"><div class="grid cols-3">
    <article class="card"><div class="title"><Icon name="shield" /> What is it?</div><p class="desc" style="margin:0">The top-tier home plan, with the broadest set of security, privacy and support features.</p></article>
    <article class="card"><div class="title"><Icon name="users" /> Who is it for?</div><p class="desc" style="margin:0">Families and demanding users who want the most complete coverage across several devices.</p></article>
    <article class="card"><div class="title"><Icon name="check" /> Differences</div><p class="desc" style="margin:0">It surpasses <a href="/en/kaspersky-standard-panama/">Standard</a> and <a href="/en/kaspersky-plus-panama/">Plus</a> in features and support, with higher device-count options.</p></article>
  </div></div></section>
  <section class="section bg-alt">
    <div class="container">
      <div class="grid cols-2" style="gap:40px;align-items:start">
        <div>
          <h2>What does Kaspersky Premium include?</h2>
          <ul class="list" style="list-style:none;padding:0;display:grid;gap:11px;margin-top:14px">
            <li><Icon name="check" /> Everything in Standard and Plus</li>
            <li><Icon name="check" /> The highest tier of security and privacy features</li>
            <li><Icon name="check" /> Priority vendor support</li>
            <li><Icon name="check" /> Identity-protection features</li>
            <li><Icon name="check" /> Up to 20 devices in a single plan</li>
          </ul>
        </div>
        <div class="card">
          <div class="title"><Icon name="users" /> Who is it ideal for?</div>
          <p class="desc">Ideal for families and demanding users who want the most complete coverage, with the highest device count and top-tier support.</p>
          <p class="muted" style="font-size:.86rem;margin:0">Not sure which to choose? Message us and we will advise you with no obligation.</p>
        </div>
      </div>
    </div>
  </section>

</ProductLayout>
