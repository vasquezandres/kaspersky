---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const lang = 'es' as const;
---
<BaseLayout
  lang={lang}
  esPath="/cotizar/"
  title="Tu cotización | Kaspersky Panamá — Solutech"
  description="Revisa el resumen de tu cotización de licencias Kaspersky y envíanosla por WhatsApp o correo. Soporte local de Solutech Panamá."
  noindex={true}
>
  <section class="section tight">
    <div class="container">
      <nav class="breadcrumb" aria-label="breadcrumb"><a href="/">Inicio</a> &nbsp;/&nbsp; <span>Cotización</span></nav>
      <span class="eyebrow" style="margin-top:18px">Cotización</span>
      <h1>Resumen de tu cotización</h1>
      <p class="lead">Revisa los detalles y envíanos la solicitud. Te confirmamos disponibilidad, total con ITBMS (si aplica) y métodos de pago.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="card plan-card" style="max-width:560px">
        <div class="title" id="q-name">Producto Kaspersky</div>
        <div class="desc" id="q-desc">—</div>
        <div class="price"><span id="q-price" data-state="consult">Consultar</span> <small id="q-itbms"></small></div>
      </article>

      <h2 class="mt-4">Tus datos</h2>
      <form id="q-form" class="form" action={`https://formspree.io/f/${site.formspreeId}`} method="POST">
        <div class="field"><label for="q-cname">Nombre y apellido</label><input id="q-cname" class="input" name="name" required /></div>
        <div class="field"><label for="q-cemail">Correo</label><input id="q-cemail" class="input" type="email" name="email" required /></div>
        <div class="field"><label for="q-ccompany">Empresa / RUC (opcional)</label><input id="q-ccompany" class="input" name="company" /></div>
        <div class="field"><label for="q-cextra">Comentarios</label><textarea id="q-cextra" class="textarea" name="extra" placeholder="Forma de pago, fecha requerida, etc."></textarea></div>
        <input type="hidden" name="_subject" value="Cotización Kaspersky — Solutech Panamá" />
        <input type="hidden" name="producto" id="q-h-producto" />
        <input type="hidden" name="detalle" id="q-h-detalle" />
        <input type="hidden" name="precio" id="q-h-precio" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="btn-row">
          <button class="btn primary" type="submit"><Icon name="send" /> Enviar cotización</button>
          <a id="q-wa" class="btn wa" target="_blank" rel="noopener"><Icon name="whatsapp" /> Enviar por WhatsApp</a>
        </div>
        <p class="muted" style="font-size:.82rem">También puedes escribirnos a <a href={`mailto:${site.email}`}>{site.email}</a>. No solicitamos contraseñas ni datos bancarios.</p>
      </form>

      <div class="mt-4"><DisclaimerBanner lang={lang} /></div>
    </div>
  </section>

  <script type="module" define:vars={{ SHEET_ID: site.sheetId, DEFAULT_SHEET: site.defaultSheet, WA: site.whatsapp }}>
    function getParams() { const u = new URL(location.href); const o = {}; u.searchParams.forEach((v, k) => (o[k] = v)); return o; }
    function fmt(n) { return new Intl.NumberFormat('es-PA', { style: 'currency', currency: 'USD' }).format(+n || 0); }
    function activeSheet() {
      const q = new URL(location.href).searchParams.get('sheet');
      if (q) { try { localStorage.setItem('kp-sheet', q); } catch (e) {} return q; }
      try { return localStorage.getItem('kp-sheet') || DEFAULT_SHEET; } catch (e) { return DEFAULT_SHEET; }
    }
    async function priceBySKU(sku) {
      if (!sku) return 0;
      try {
        const url = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(activeSheet())}`;
        const raw = await fetch(url).then((r) => r.text());
        const json = JSON.parse(raw.substring(raw.indexOf('{'), raw.lastIndexOf('}') + 1));
        const cols = json.table.cols.map((c) => c.label);
        const rows = json.table.rows.map((r) => r.c.map((c) => (c ? c.v : '')));
        const list = rows.map((r) => Object.fromEntries(r.map((v, i) => [cols[i], v])));
        const row = list.find((r) => String(r.SKU || '').trim() === String(sku).trim());
        return row ? +String(row.PrecioUSD || '0').replace(/[^0-9.]/g, '') : 0;
      } catch (e) { return 0; }
    }

    const p = getParams();
    const name = p.product || 'Producto Kaspersky';
    const details = [
      p.devices ? `${p.devices} dispositivo(s)` : '',
      p.nodes ? `${p.nodes} nodos (tramo ${p.range || ''})` : '',
      p.pack ? `Pack ${p.pack} equipos` : '',
      p.years ? `${p.years} año(s)` : '',
      p.sku ? `SKU ${p.sku}` : '',
    ].filter(Boolean).join(' • ') || '—';

    document.getElementById('q-name').textContent = name;
    document.getElementById('q-desc').textContent = details;

    const price = await priceBySKU(p.sku);
    const totalParam = p.total ? +p.total : 0;
    const shown = totalParam > 0 ? totalParam : price;
    const priceTxt = shown > 0 ? fmt(shown) : 'Consultar';
    const priceEl = document.getElementById('q-price');
    priceEl.textContent = priceTxt;
    if (shown > 0) { priceEl.removeAttribute('data-state'); document.getElementById('q-itbms').textContent = (p.unit ? `${fmt(+p.unit)}/equipo × ${p.nodes} · ` : '') + '+ ITBMS si aplica'; }

    document.getElementById('q-h-producto').value = name;
    document.getElementById('q-h-detalle').value = details;
    document.getElementById('q-h-precio').value = priceTxt;

    const waTxt = `Hola, quiero esta cotización Kaspersky:%0A%0A${encodeURIComponent(name)}%0A${encodeURIComponent(details)}%0APrecio: ${encodeURIComponent(priceTxt)} (ITBMS según aplique)`;
    document.getElementById('q-wa').href = `https://wa.me/${WA}?text=${waTxt}`;

    const form = document.getElementById('q-form');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]');
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
        if (res.ok) { location.href = '/gracias/'; }
        else { alert('No pudimos enviar la cotización. Escríbenos por WhatsApp.'); if (btn) btn.disabled = false; }
      } catch (err) { alert('Error de red. Intenta de nuevo o escríbenos por WhatsApp.'); if (btn) btn.disabled = false; }
    });
  </script>
</BaseLayout>
