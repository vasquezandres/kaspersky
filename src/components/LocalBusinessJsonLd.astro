---
import { site } from '../data/site';
// Organización principal = Solutech Panamá (revendedor independiente).
// NO se marca a Solutech como fabricante de Kaspersky.
const data = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': site.baseUrl + '/#solutech',
  name: 'Solutech Panamá',
  url: site.baseUrl,
  image: site.baseUrl + '/assets/img/og/kaspersky-panama-solutech.svg',
  description:
    'Proveedor/revendedor independiente de licencias Kaspersky en Panamá. Cotización, renovación, instalación y soporte técnico local por Solutech Panamá.',
  telephone: '+507-6888-6778',
  email: site.email,
  priceRange: '$$',
  areaServed: { '@type': 'Country', name: 'Panama' },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'PA',
    addressLocality: 'Ciudad de Panamá',
    addressRegion: 'Panamá',
  },
  sameAs: [site.mainSiteUrl, site.social.instagram, site.social.facebook],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '09:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '13:00' },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)} />
